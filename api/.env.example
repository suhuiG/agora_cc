# Agora API 환경변수 예시 — 실제 값은 .env(비커밋)에 두고 이 파일은 템플릿으로 커밋해요.
# 계약 단일 출처: docs/05-operations.md §3, 로더: src/agora/shared/config.py + shared/deps.py
#
# 백엔드는 AWS 단일 구조예요(mock 없음). 이 파일을 복사해 값을 채운 뒤
# `set -a && source .env && set +a`로 주입하고, AWS dev 계정 크리덴셜(AWS_PROFILE=dev 등)을
# 함께 설정해요. [S]는 로컬과 포털이 같은 Agora 데이터/인프라를 가리키는 좌표이고,
# [E]는 각 프로세스가 따로 소유하는 운영 설정이에요. [E]는 포털 배포로 복사되지 않아요.

# ─────────────────────────────────────────────────────────────
# [S] SHARED — Agora가 만든 데이터·인프라 좌표
# [코어] 서버 기동 필수
# ─────────────────────────────────────────────────────────────
# 리소스명/배선 축: dev | prod. 로컬/포털 구분자가 아니며 둘 다 prod일 수 있어요.
AGORA_STAGE=dev

# 레지스트리(AWS Agent Registry) 리전 — us-east-1 고정(다르면 부팅 실패).
AGORA_REGION=us-east-1

# Registry 서비스 네임스페이스(CA-05/ADR-0015). agent-registry(기본, 전용 네임스페이스,
# .api.aws endpoint·새 descriptor 스키마) | bedrock-agentcore(구 공개 프리뷰, 폐기).
# 구 네임스페이스는 신규 계정에서 IAM 이 거부해요 — Admin 으로도
# `bedrock-agentcore:ListRegistries` 가 AccessDenied 이고, CDK 가 부여하는 registry
# grant 도 `agent-registry:*` 뿐이에요. 되돌릴 때만 값을 바꿔요.
AGORA_REGISTRY_NAMESPACE=agent-registry

# 카탈로그 DynamoDB 테이블명 (필수 — CDK output에서 주입, 없으면 부팅 실패)
# AGORA_TABLE_NAME=

# 카탈로그 S3 버킷명 (필수 — CDK output에서 주입, 없으면 부팅 실패)
# AGORA_BUCKET_NAME=

# AWS Agent Registry ID (재사용, 미지정 시 이름으로 조회/생성)
# AGORA_REGISTRY_ID=

# 소스스토어(S3·DDB) 실물 리전. 메타=us-east-1 Registry / 실물=서울 분리.
# AGORA_SOURCE_REGION=ap-northeast-2

# ─────────────────────────────────────────────────────────────
# [스토어 백엔드] HP-04 — 로컬도 배포서버와 동일하게 DynamoDB를 써요.
# 이 세 테이블 env가 설정되면 gov/bundle/connection이 공유 DynamoDB로,
# 없으면 컨테이너 로컬 JSON으로 떨어져요(재시작·다중 인스턴스에서 휘발).
# 로컬 개발도 아래 dev 테이블을 배선해 배포서버와 같은 스토어를 쓰는 게 원칙이에요.
# ⚠️ 로컬 실행이 실 dev 테이블을 배포 포털과 공유해요(데이터 공유). 파괴적 조작 주의.
# 테이블명은 CDK가 결정적으로 만들어요: AgoraGov-{stage}(scan-tools 스택),
# AgoraBundle-{stage}·AgoraConnection-{stage}(catalog-storage 스택).
AGORA_GOV_TABLE=AgoraGov-dev
AGORA_BUNDLE_TABLE=AgoraBundle-dev
AGORA_CONNECTION_TABLE=AgoraConnection-dev
# [S/monitoring] MonitoringAggregateStack output. 둘은 함께 설정해요.
# AGORA_MONITORING_AGGREGATE_TABLE=AgoraMonitoringAggregate-dev
# AGORA_MONITORING_INGEST_DLQ_URL=https://sqs.ap-northeast-2.amazonaws.com/.../...
# [S/monitoring-lambda] stack 직접 배선. Portal env가 아니에요.
# AGORA_MONITORING_STAGE=dev
# AGORA_MONITORING_DEPLOY_JOBS_TABLE=AgoraDeployJobs-dev
# PAT 등 credential 원문은 stage 무관 항상 Secrets Manager에 둬요(로컬도). JSON 파일 없음.

# ─────────────────────────────────────────────────────────────
# [사람 인증] AgoraIdentity-<stage> CDK output
# ─────────────────────────────────────────────────────────────
# AGORA_AUTH_MODE=cognito 일 때 필수. Runtime M2M Cognito 값과 혼용하지 않아요.
# AGORA_AUTH_COGNITO_ISSUER=                       # HumanCognitoIssuer output
# AGORA_AUTH_COGNITO_CLIENT_ID=                    # HumanCognitoClientId output

# [S/identity] AccessGrant, AssetCapability, Delegation, invocation audit,
# DEV_CREDENTIAL# 저장소.
# 미지정 시 agora-identity-${AGORA_STAGE}, 리전은 서울로 파생돼요.
# AGORA_IDENTITY_TABLE=agora-identity-dev
# AGORA_IDENTITY_REGION=ap-northeast-2

# ─────────────────────────────────────────────────────────────
# [배포 파이프라인] MCP·Agent 호스팅 (M1·M3).
# Runtime workload Cognito 좌표는 AgoraIdentity-<stage>의 사람 pool을 가리켜요.
# deploy/connect 기능을 쓸 때만 필요.
# ─────────────────────────────────────────────────────────────
# AGORA_DEPLOY_REGION=us-east-1                  # 미지정 시 AGORA_REGION
# AGORA_DEPLOY_GATEWAY_ID=                        # 공유 AgentCore Gateway ID(불변 URL)
# AGORA_DEPLOY_JOBS_TABLE=                        # 배포 job 상태 DynamoDB 테이블
# AGORA_DEPLOY_EXEC_ROLE_ARN=                     # Lambda 실행롤 ARN(MCP 배포)
# AGORA_DEPLOY_AGENT_EXEC_ROLE_ARN=              # AgentCore Runtime 실행롤(agent, 미지정 시 위로 폴백)
# [S] AGORA_DEPLOY_AGENT_SHARED_POLICY_ARN=       # AgentRuntimeSharedPolicyArn CDK output
# [S] AGORA_DEPLOY_AGENT_PERMISSIONS_BOUNDARY_ARN= # isolated-agent PermissionBoundaryArn CDK output
# [S] AGORA_DEPLOY_BUILTIN_EXEC_ROLE_ARN=         # agent별 CUSTOM 내장 도구 실행롤
# [S] AGORA_DEPLOY_BUILTIN_RECORDING_BUCKET=      # Browser 세션 녹화 버킷
# AGORA_DEPLOY_ECR_URI=                           # 컨테이너 빌드 ECR 리포지토리 URI
# AGORA_DEPLOY_CODEBUILD_PROJECT=                # 소스→아티팩트 CodeBuild 프로젝트
# AGORA_DEPLOY_ARTIFACT_BUCKET=                  # codezip 빌드 산출물 S3 버킷
# 아래 discovery/client/scope/token URL 네 값은 한 사람 pool 기계 client 묶음으로 함께 바꿔요.
# [S] AGORA_DEPLOY_COGNITO_DISCOVERY_URL=         # 사람 pool HumanCognitoIssuer + /.well-known/openid-configuration
# [S] AGORA_DEPLOY_COGNITO_CLIENT_ID=             # 같은 pool의 agora-human-workload-<stage> client ID
# [S] AGORA_DEPLOY_COGNITO_HUMAN_CLIENT_ID=       # 【폐기 예정 · IA-89 ②】 소비자 0건이라 Runtime allowedClients 에서 제거. 설정해도 무시됨(키 삭제는 다음 회차)
# [S] AGORA_DEPLOY_COGNITO_SCOPE=                 # 같은 pool 기계 client의 workload invoke scope
# [S] AGORA_DEPLOY_COGNITO_TOKEN_URL=             # 같은 pool HumanCognitoDomain + /oauth2/token
# AGORA_HARNESS_INVOKE_COGNITO_TOKEN_URL=        # 같은 pool/client의 oauth2/token URL
# AGORA_RUNTIME_AUTHORIZATION_URL=               # RuntimeAuthorizationUrl CDK output
# [E] unknown 인가 판정 차단. IA-38 승인 전에는 0 유지.
# IH-48 독립 관측 채널 전까지 1이면 도구 있는 agent 배포가 모두 차단됨.
AGORA_RUNTIME_FAIL_CLOSED_ON_UNKNOWN_AUTHORIZATION=0
# [E] 내장 도구 이름만 관측되고 도달성 probe가 없을 때 배포 차단.
# IH-57 독립 도달성 probe 전까지 기본 0은 unknown을 원장에 남기고 진행함.
AGORA_RUNTIME_FAIL_CLOSED_ON_UNKNOWN_BUILTIN_TOOLS=0
# [E] MCP identity outbound 배선 실패 시 배포 차단. 거버넌스 기본은 fail-closed.
AGORA_RUNTIME_FAIL_CLOSED_ON_IDENTITY_OUTBOUND=1
# [E] agent별 실행 role 사용. 기본 1; 긴급 레거시 rollback만 0.
AGORA_RUNTIME_PER_AGENT_ROLES_ENABLED=1

# ─────────────────────────────────────────────────────────────
# [M2 IAM Gateway] 축1 M2. AgentPolicyDeployer가 Cedar policy를 배포할 대상.
# ─────────────────────────────────────────────────────────────
# M2 IAM Gateway (dev). AgoraM2Gateway-dev CDK outputs M2PolicyEngineId / M2GatewayArn.
AGORA_M2_POLICY_ENGINE_ID=
AGORA_M2_GATEWAY_ARN=

# M2 OAuth Gateway (ADR-0016).
# ⚠️ 이 값은 **agent 별 M2M app client 를 발급하는 pool** 이고, 지금은
# `AgoraM2OAuthGateway-<stage>` 의 `M2OAuthCognitoUserPoolId`(그 스택 자신의 봇 pool)예요.
# 사람 pool(`HumanUserPoolId`)을 넣으면 안 돼요 — apiExecutionRole 의
# `cognito-idp:CreateUserPoolClient` 는 봇 pool 에만 부여돼 있어서 agent 배포가
# AccessDenied 로 죽어요. 사람 pool 로의 이전은 IA-78 소관이고 아직 안 됐어요.
# `AGORA_M2_OAUTH_DISCOVERY_URL` 도 같은 pool 을 가리켜야 해요(synth 가 대조해요).
AGORA_M2_OAUTH_COGNITO_USER_POOL_ID=              # [S] M2OAuthCognitoUserPoolId
# [S] HumanCognitoClientId output. 여러 web client면 CSV; interceptor Lambda에만 주입해요.
AGORA_GATEWAY_HUMAN_CLIENT_IDS=
# [S] 사람 pool resource server와 Gateway allowedScopes가 공유하는 정확한 문자열.
# 형식 예: https://agora-m2-oauth-dev/invoke. 아래 M2 OAuth 좌표를 모두 채울 때만 설정해요.
AGORA_M2_OAUTH_SCOPE=
# [S] HumanCognitoIssuer + /.well-known/openid-configuration.
# IA-80 이후 **CDK 입력이기도 해요** — `AgoraM2OAuthGateway-<stage>` 의 Gateway
# `customJWTAuthorizer.discoveryUrl` 이 이 값을 써요. 그래서 `cdk synth`·`cdk deploy` 전에
# `set -a; source ../api/.env; set +a` 가 필요해요. 미설정이면 봇 pool 로 폴백해요(되돌리기
# 경로) — 형제 AGORA_GATEWAY_HUMAN_CLIENT_IDS 와 달리 synth 를 실패시키지 않아요.
# 형태가 https:// + /.well-known/openid-configuration 이 아니면 synth 가 거부해요.
AGORA_M2_OAUTH_DISCOVERY_URL=
# [S] HumanCognitoDomain + /oauth2/token. discovery URL에서 추측하지 않아요.
AGORA_M2_OAUTH_TOKEN_URL=
AGORA_M2_OAUTH_GATEWAY_ID=
AGORA_M2_OAUTH_GATEWAY_URL=
AGORA_M2_OAUTH_GATEWAY_ARN=
AGORA_M2_OAUTH_POLICY_ENGINE_ARN=
# [E] PortalStack이 실제 CDK context와 같은 값을 주입. local 미설정은 UI에서 unknown.
AGORA_M2_OAUTH_GATEWAY_MODE=

# Initializr 로컬 실행용 임시 dev identity. credential은 기존 AGORA_IDENTITY_TABLE에
# DEV_CREDENTIAL# 접두사로 저장하며 별도 테이블을 만들지 않아요.
AGORA_DEV_IDENTITY_CREDENTIAL_TTL_DAYS=7
AGORA_DEV_IDENTITY_CREDENTIAL_TTL_MAX_DAYS=30
AGORA_DEV_IDENTITY_TOKEN_TTL_MINUTES=60

# Token Vault provider ARN. {provider_name} 또는 agent hash인 {agent_key}를 사용할 수 있어요.
AGORA_HARNESS_OAUTH_PROVIDER_ARN_TEMPLATE=
# Harness 런타임 실행롤 ARN(AgoraHarness 스택 HarnessExecRoleArn output). 미지정 시
# AGORA_DEPLOY_AGENT_EXEC_ROLE_ARN으로 폴백해요.
AGORA_HARNESS_EXEC_ROLE_ARN=
# Isolated Harness export CodeBuild + KMS artifact outputs (AgoraHarnessExport stack).
# AGORA_HARNESS_EXPORT_CODEBUILD_PROJECT=
# AGORA_HARNESS_EXPORT_ARTIFACT_BUCKET=
# AGORA_HARNESS_EXPORT_ARTIFACT_KMS_KEY_ARN=

# ─────────────────────────────────────────────────────────────
# [거버넌스 스캔 좌표] M2. AGORA_SCANNER 모드에 따라 필요 변수가 달라져요.
# ─────────────────────────────────────────────────────────────
# AGORA_SFN_ARN=                                  # (stepfn) 스캔 오케스트레이션 Step Functions ARN
# AGORA_SCAN_BUCKET=                              # (stepfn·fargate) 스캔 I/O S3 버킷
# AGORA_SCAN_REGION=ap-northeast-2               # 스캔 도구·SFN·GovTable 리전
# AGORA_SCAN_TOOLS_STAGE=                        # 스캔 도구 로그 조회 stage 오버라이드(미지정 시 AGORA_STAGE).
#                                                # 로컬 prod-mode에서 dev 계정 -dev 스캔 도구 로그 조회 시 dev로.
# AGORA_SCAN_CLUSTER=                            # (fargate) ECS 클러스터
# AGORA_SCAN_TASKDEF=                            # (fargate) ECS task definition
# AGORA_SCAN_SUBNETS=                            # (fargate) 서브넷 CSV
# AGORA_SCAN_SG=                                 # (fargate) 보안그룹 CSV
# AGORA_GOV_TABLE — 위 [스토어 백엔드] 섹션 참조(HP-04). 설정 시 DynamoGovStore, 없으면 로컬 JSON.

# ─────────────────────────────────────────────────────────────
# [E] PER-ENV — 환경별 운영 설정. 포털 backendEnv로 복사되지 않아요.
# ─────────────────────────────────────────────────────────────
# 유일한 실행환경 구분자. 로컬은 local, PortalStack은 portal, Lambda 스택은 lambda를 주입해요.
AGORA_ROLE=local

# [S/runtime] 배포된 agent Runtime에만 deploy backend가 주입하는 리소스 좌표.
# Portal/API 프로세스 설정이 아니므로 로컬 .env에는 설정하지 마세요.
# AGORA_MEMORY_ID=memory-id-from-agentcore

# 인증 모드와 dev 고정 신원.
AGORA_AUTH_MODE=dev                         # cognito | dev | test
# 로컬 회귀 테스트용 tool 인가 모델. 포털과 authorizer는 agent_policy로 고정돼요.
AGORA_AUTHORIZATION_MODE=agent_policy       # agent_policy | legacy_delegated
# [E/runtime] AgentCore 전파 미확인·span 비용 때문에 기본 off.
# 요청값은 도착률 관측이 아니므로 on이어도 monitoring sampling은 unknown으로 유지.
AGORA_RUNTIME_FORCE_TRACE_SAMPLING_ENABLED=0
# AGORA_DEV_PRINCIPAL=dev-user
# AGORA_DEV_ROLES=user                      # admin 콘솔 개발 시 admin

# 배포 job 폴러 소유권. 포털은 1, 로컬/CI는 0이어야 해요.
AGORA_POLLER_ENABLED=0
# 공유 dev 자원을 포털과 함께 폴링하는 위험을 감수한 로컬 디버깅에서만 1.
# AGORA_POLLER_FORCE=0
AGORA_POLLER_INTERVAL=3

# [E] 배포 verify 에서 인가 negative control 을 못 돌렸을 때 배포를 막을지.
# 기본 0(막지 않음) — 관측 불가는 `unknown` 이고, 진행 차단은 명시적 정책이어야 해요
# (AGENTS.md § "Unobservable is not passing"). 후보가 없는 상태는 자산의 READ 를 전부
# 승인받았고 계정에 다른 승인 MCP 도 없을 때 정상적으로 생겨요. 1 로 켜면 그 배포를
# 막아요 — "강제됨을 증명하지 못한 배포" 를 아예 허용하지 않는 환경에서 쓰세요.
# AGORA_DEPLOY_REQUIRE_NEGATIVE_CONTROL=0
# [E] MCP 도구 목록 드리프트 주기 관측 (LC-03). 배포 job 폴러와 별도 스위치예요 —
# 우리 통제 밖 MCP endpoint 로 나가는 트래픽이라 소유 프로세스를 따로 고르게 했어요.
# 포털은 PortalStack 이 1로 못박아요. 로컬은 0(화면의 "다시 읽기" 는 이 값과 무관하게 동작).
AGORA_MCP_DRIFT_POLL_ENABLED=0
# 관측 주기(초). 하한 60 — 더 짧으면 남의 MCP 서버를 두드려 대요. 값이 하한 미만이면 기동 실패.
AGORA_MCP_DRIFT_POLL_INTERVAL=900
# [E/monitoring] local·portal 공통 freshness 정책. 별도 AGORA_ROLE guard는 없어요.
AGORA_MONITORING_MAX_INGEST_LAG_SECONDS=900
# [E/monitoring] 감사 GSI 양끝 미확정 구간. local·portal 공통, 양의 초.
AGORA_MONITORING_TRAFFIC_BOUNDARY_MARGIN_SECONDS=60
# [E/monitoring] 이 stage가 account/region 공유 aws/spans 적재 owner인지 여부.
# local·portal에서 의미가 같고 PortalStack이 명시 공급하므로 role guard는 없어요.
AGORA_MONITORING_INGEST_OWNER=0
# [E/monitoring-lambda] AGORA_ROLE=lambda typed loader만 허용하는 집계 TTL 정책.
# AGORA_MONITORING_RETENTION_DAYS=400

# [S]/[E, Lambda internal] TelemetryArchiveStack이 reconciler/manifest Lambda에
# 직접 주입합니다. API·Portal·로컬 shell 설정이 아니며 수동 설정하지 마세요.
# typed loader: infra/lambda/telemetry-archive-reconciler/config.py
# [S] AGORA_TELEMETRY_STAGE
# [S] AGORA_TELEMETRY_RUNTIME_LOG_GROUP_PREFIX
# [S] AGORA_TELEMETRY_SHARED_SPAN_LOG_GROUP
# [E] AGORA_TELEMETRY_MANAGE_SHARED_SPANS
# [S] AGORA_TELEMETRY_DESTINATION_ARN
# [S] AGORA_TELEMETRY_SUBSCRIPTION_ROLE_ARN
# [S] AGORA_TELEMETRY_SUBSCRIPTION_FILTER_NAME
# [S] AGORA_TELEMETRY_SHARED_SPAN_FILTER_NAME
# [S] AGORA_TELEMETRY_DEPLOY_JOBS_TABLE
# [S] AGORA_TELEMETRY_COVERAGE_TABLE
# [S] AGORA_TELEMETRY_ARCHIVE_BUCKET
# [E] AGORA_TELEMETRY_MAX_INGEST_LAG_SECONDS

# [E] 이 프로세스의 공개 포털 origin. PortalStack은 개발자 셸 값을 복사하지 않고
# CloudFront domain으로 덮어쓰며, AGORA_ROLE=portal은 loopback을 거부해요.
# AgentCore outbound 3LO 허용목록의 /api/auth/external/callback도 여기서 파생해요.
AGORA_WEB_BASE_URL=http://localhost:3000

# 로컬은 memory/static, 포털은 aws/stepfn을 스택이 강제해요.
AGORA_HARNESS_BACKEND=memory
# AGORA_SCANNER=static                      # static | noop | stepfn | fargate
# AGORA_SCAN_TIMEOUT=300

# [LLM 배선] 로컬 오프라인 오버라이드. 포털 운영값과 공유하지 않아요.
# AGORA_REPORT_LLM=bedrock                        # bedrock | template (위협리포트 생성기)
# AGORA_COMPUTE_LLM=bedrock                       # bedrock | rule (도구 compute 분류기)

# 참고: AGORA_MCP_MODULE·AGORA_SOURCE_ROOT·AGORA_TOOLS_OUT은 빌드/Lambda 런타임이
# 내부에서 세팅해요 — 운영자가 .env에 넣는 값이 아니에요.
