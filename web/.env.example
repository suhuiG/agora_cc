# Agora Web 서버 환경변수 예시. 실제 값은 .env.local(비커밋)에 두세요.
# Cognito token과 세션 테이블 정보는 NEXT_PUBLIC_*로 노출하지 않아요.
AGORA_WEB_AUTH_MODE=cognito
AGORA_WEB_BASE_URL=http://localhost:3000
AGORA_API_URL=http://localhost:9100
AGORA_AUTH_REGION=ap-northeast-2
AGORA_AUTH_COGNITO_CLIENT_ID=replace-after-cdk-deploy
# 브라우저 SRP 로그인이 /api/config로 읽는 공개 User Pool ID (HumanUserPoolId output)
AGORA_AUTH_COGNITO_USER_POOL_ID=ap-northeast-2_xxxxxxxxx
AGORA_AUTH_COGNITO_DOMAIN=https://replace.auth.ap-northeast-2.amazoncognito.com
AGORA_AUTH_SESSION_TABLE=agora-human-auth-session-dev
